{
  "manifestVersion": 1,
  "id": "upwind-image-scan-dev",
  "publisher": "upwindsecurity",
  "version": "0.0.1",
  "name": "Upwind Image Scan (Dev)",
  "description": "Scan container images with Upwind ShiftLeft and comment the results on pull requests. Development build.",
  "public": false,
  "categories": [
    "Azure Pipelines"
  ],
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "icons": {
    "default": "images/icon.png"
  },
  "files": [
    {
      "path": "task"
    }
  ],
  "contributions": [
    {
      "id": "upwind-image-scan-task",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "task"
      }
    }
  ]
}
